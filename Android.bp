package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "privapp_permissions_com.legacydroid.luminaai",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-com.legacydroid.luminaai.xml",
    filename_from_src: true,
}

android_app {
    name: "LuminaAI",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    // Live2D model and shaders, staged by live2d/get_vendor.sh. A committed
    // .keep keeps the dir valid before staging, the avatar just reports as
    // unavailable at runtime.
    asset_dirs: ["live2d/assets"],

    // Native Live2D engine. Extracted to priv-app lib at scan time because
    // embedded libs are unreliable for preinstalled system_ext apps here.
    jni_libs: ["libluminalive2d"],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",

    privileged: true,
    system_ext_specific: true,

    required: [
        "privapp_permissions_com.legacydroid.luminaai",
    ],

    optimize: {
        enabled: true,
        optimize: true,
        shrink: true,
        shrink_resources: true,
        proguard_compatibility: false,
        proguard_flags_files: ["live2d/proguard.flags"],
    },

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.ui_ui-util",
        "kotlinx-coroutines-android",
    ],

    kotlincflags: ["-Xjvm-default=all"],
}